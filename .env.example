TELOXIDE_TOKEN=123456789:replace_me
EXPECTED_BOT_USERNAME=chekla_qalqon_bot
# Ixtiyoriy: self-hosted Telegram Bot API yoki lokal test server bazaviy URL'i.
# TELEGRAM_API_URL=http://127.0.0.1:58080/
DATABASE_URL=postgres://qalqon:change_me@localhost:5432/qalqon
DATABASE_MAX_CONNECTIONS=10
# Vergul bilan ajratilgan Telegram user ID'lar. Guruh adminiga qo'shimcha owner override.
OWNER_IDS=
ADMIN_CACHE_TTL_SECS=300
POLICY_CACHE_TTL_SECS=30
DATABASE_CONNECT_MAX_ATTEMPTS=10
DATABASE_CONNECT_BACKOFF_MS=500
HEALTH_ADDR=0.0.0.0:8080
API_ADDR=0.0.0.0:8081
# Lokal API porti. Productionda HTTPS reverse proxy shu portga ulanadi.
API_BIND_HOST=127.0.0.1
API_PORT=8081
# Mini App initData maksimal yoshi. Production default: 1 soat.
MINI_APP_AUTH_MAX_AGE_SECS=3600
# Reverse proxy bilan bir origin bo'lsa bo'sh qoldiring; aks holda aniq HTTPS origin kiriting.
# MINI_APP_ORIGIN=https://app.example.com
# Telegram private chat menu tugmasida ochiladigan production HTTPS URL.
# MINI_APP_URL=https://chekla-mini.example.com
RUST_LOG=qalqon=info,teloxide=info
